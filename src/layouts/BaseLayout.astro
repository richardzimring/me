---
import BaseHead from '../components/BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteName from '../components/SiteName.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** When true, hide the site-name link (home uses h1 as the name). */
  home?: boolean;
  /** Wider column for long-form reading. */
  prose?: boolean;
}

const { title, description, ogImage, home = false, prose = false } = Astro.props;

const barClass = ['site-bar', home && 'site-bar--home', prose && 'site-bar--prose']
  .filter(Boolean)
  .join(' ');
const pageClass = ['page', prose && 'page--prose'].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <header class={barClass}>
      {!home && <SiteName />}
      <ThemeToggle />
    </header>
    <main class={pageClass}>
      <slot />
    </main>
    <script>
      document.querySelectorAll('a[href]').forEach((a) => {
        const href = (a as HTMLAnchorElement).href;
        try {
          const url = new URL(href, window.location.href);
          if (url.origin !== window.location.origin) {
            a.setAttribute('target', '_blank');
            a.setAttribute('rel', 'noopener noreferrer');
          }
        } catch {
          // malformed href · leave as-is
        }
      });
    </script>
  </body>
</html>
