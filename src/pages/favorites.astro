---
import BaseLayout from '../layouts/BaseLayout.astro';
import { library, kindOrder, kindLabel, type LibraryItemKind } from '../data/library';
import { quotes } from '../data/quotes';

const grouped = kindOrder
  .map((kind) => ({
    kind,
    items: library.filter((item) => item.kind === kind),
  }))
  .filter((g) => g.items.length > 0);

const ROTATE_MS = 30_000;
---

<BaseLayout
  title="Favorites · Richard Zimring"
  description="Quotes, books, films, and other favorites."
>
  <h1 class="page-title">Favorites</h1>

  {
    grouped.map((g) => (
      <section class="lib-group" id={kindLabel[g.kind as LibraryItemKind]}>
        <h2>{kindLabel[g.kind as LibraryItemKind]}</h2>
        {g.items.map((item) => (
          <a class="lib-row" href={item.href}>
            <span class="lib-title">{item.title}</span>
            {item.by && <span class="lib-by">{item.by}</span>}
          </a>
        ))}
      </section>
    ))
  }

  <blockquote class="favorites-quote is-pending" data-favorites-quote>
    <p data-favorites-quote-text></p>
    <cite data-favorites-quote-author></cite>
  </blockquote>
</BaseLayout>

<script define:vars={{ quotes, ROTATE_MS }}>
  const root = document.querySelector('[data-favorites-quote]');
  const textEl = root?.querySelector('[data-favorites-quote-text]');
  const authorEl = root?.querySelector('[data-favorites-quote-author]');
  if (!(root instanceof HTMLElement) || !textEl || !authorEl || quotes.length === 0) return;

  let index = Math.floor(Math.random() * quotes.length);
  let fading = false;

  const show = (next) => {
    const quote = quotes[next];
    textEl.textContent = quote.text;
    authorEl.textContent = '— ' + quote.author;
    index = next;
  };

  show(index);
  root.classList.remove('is-pending');

  if (quotes.length < 2) return;

  const advance = () => {
    if (fading) return;
    fading = true;
    root.classList.add('is-fading');

    const finish = () => {
      root.removeEventListener('transitionend', onFadeOut);
      window.clearTimeout(fallback);
      show((index + 1) % quotes.length);
      requestAnimationFrame(() => {
        root.classList.remove('is-fading');
        fading = false;
      });
    };

    const onFadeOut = (event) => {
      if (event.target !== root || event.propertyName !== 'opacity') return;
      finish();
    };

    root.addEventListener('transitionend', onFadeOut);
    const fallback = window.setTimeout(finish, 800);
  };

  window.setInterval(advance, ROTATE_MS);
</script>
