---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { getPublishedPosts } from '../lib/posts';

const allPosts = await getPublishedPosts();

const formatDate = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title="Richard Zimring" description="A personal site" home>
  <h1 class="page-title page-title--flush">Richard Zimring</h1>
  <p class="bio">
    Building <a href="https://maven.sportradar.com">Maven</a> at <a href="https://sportradar.com"
      >Sportradar</a
    >. Previously crypto research at <a href="https://kellogg.northwestern.edu">Kellogg</a>, CS at
    Northwestern.
  </p>

  {
    allPosts.length > 0 && (
      <ul class="list">
        {allPosts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            <span class="list-meta">
              {post.data.draft && <span class="draft-label">draft</span>}
              {formatDate(post.data.date)}
            </span>
          </li>
        ))}
      </ul>
    )
  }

  <ul class="list">
    {
      projects.map((p) => (
        <li>
          <a href={`/projects/${p.slug}/`}>{p.name}</a>
          <span class="list-meta">{p.tagline}</span>
        </li>
      ))
    }
  </ul>

  <p class="footer-links">
    <a href="/resume/">Resume</a>
    <a href="/favorites/">Favorites</a>
    <a href="https://github.com/richardzimring">GitHub</a>
    <a href="https://linkedin.com/in/richardzimring">LinkedIn</a>
  </p>
</BaseLayout>
