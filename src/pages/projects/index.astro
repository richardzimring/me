---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
---

<BaseLayout title="Projects · Richard Zimring" description="Projects" ogImage="/og/projects.png">
  <h1 class="page-title">Projects</h1>

  <ul class="list">
    {
      projects.map((p) => (
        <li>
          <a href={`/projects/${p.slug}/`}>{p.name}</a>
          <span class="list-meta">{p.tagline}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
