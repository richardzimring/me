---
import ThemeToggle from './ThemeToggle.astro';
import { getPublishedPosts } from '../lib/posts';

interface Props {
  path?: string;
  active?: 'index' | 'writing' | 'projects' | 'library' | 'resume' | null;
}

const { path = '~', active = null } = Astro.props;
const hasPosts = (await getPublishedPosts()).length > 0;
---

<header class="titlebar">
  <div class="traffic" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="titlebar-path">
    <span class="tilde">~</span>{path !== '~' && <>{path}</>}
  </div>

  <div class="titlebar-right">
    <nav class="tabs" aria-label="Primary">
      <a href="/" class={`tab-essential${active === 'index' ? ' active' : ''}`}>index</a>
      {
        hasPosts && (
          <a href="/posts/" class={`tab-essential${active === 'writing' ? ' active' : ''}`}>
            writing
          </a>
        )
      }
      <a href="/projects/" class={active === 'projects' ? 'active' : ''}>projects</a>
      <a href="/library/" class={active === 'library' ? 'active' : ''}>library</a>
      <a href="/resume/" class={`tab-essential${active === 'resume' ? ' active' : ''}`}>resume</a>
    </nav>
    <ThemeToggle />
  </div>
</header>
